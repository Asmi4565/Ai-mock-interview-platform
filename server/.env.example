PORT=5000

# MongoDB Connection:
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/ai_mock_interview
#
# For MongoDB Atlas (Direct Replica Set URI recommended to avoid Windows querySrv ETIMEOUT issues):
# MONGODB_URI="mongodb://<username>:<password>@ac-ldlwprv-shard-00-00.vpyjvl7.mongodb.net:27017,ac-ldlwprv-shard-00-01.vpyjvl7.mongodb.net:27017,ac-ldlwprv-shard-00-02.vpyjvl7.mongodb.net:27017/ai_mock_interview?ssl=true&replicaSet=atlas-8qnl14-shard-0&authSource=admin&retryWrites=true&w=majority"
MONGODB_URI=mongodb://localhost:27017/ai_mock_interview

JWT_SECRET=super_secret_jwt_key_change_in_production

# AI Provider: 'gemini' (recommended) or 'openai'
AI_PROVIDER=gemini
# Get a free Gemini API key at https://aistudio.google.com/
# (If omitted or invalid, automated rubric fallback evaluator will engage automatically)
AI_API_KEY=your_gemini_api_key_here

